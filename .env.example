# Copy to the repository root as .env and replace every value marked CHANGE_ME.
POSTGRES_USER=smart_visitors
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=smart_visitors
DATABASE_URL=postgres://smart_visitors:CHANGE_ME_POSTGRES_PASSWORD@db:5432/smart_visitors?sslmode=disable

JWT_SECRET=CHANGE_ME_64_HEX_CHARACTERS
MASTER_KEY=CHANGE_ME_64_HEX_CHARACTERS
BOOTSTRAP_ADMIN_USER=dev
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
ISSUER_ED25519_PRIV=

PASS_MAX_HOURS=24
RETENTION_PASS_DAYS=30
RETENTION_LOG_DAYS=90
TOKEN_TTL_HOURS=12
RATE_LIMIT_SCAN=30
RATE_LIMIT_PUBLIC=10
RATE_LIMIT_LOGIN=5

ML_URL=http://ml:8100
ML_SERVICE_TOKEN=CHANGE_ME_LONG_RANDOM_SERVICE_TOKEN
APP_BASE_URL=http://localhost:4000
APP_DOMAIN=localhost
APP_SCHEME=http
HTTP_HOST_PORT=4000
OFF_HOUR_START=22
OFF_HOUR_END=6
ANOMALY_CONTAMINATION=0.1
PHOTOS_DIR=/data/photos
AI_ARTIFACT_DIR=/data/artifacts
AI_MAX_QUERY_ROWS=50
PORT=8000
LOG_LEVEL=info

NEXT_PUBLIC_SAAS_URL=http://localhost:4000
API_URL=http://api:8000
