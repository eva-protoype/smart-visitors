# Copy to the repository root as .env and replace every value marked CHANGE_ME.
POSTGRES_USER=smart_visitors
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=smart_visitors
DATABASE_URL=postgres://smart_visitors:CHANGE_ME_POSTGRES_PASSWORD@db:5432/smart_visitors?sslmode=disable

JWT_SECRET=CHANGE_ME_64_HEX_CHARACTERS
MASTER_KEY=CHANGE_ME_64_HEX_CHARACTERS
BOOTSTRAP_ADMIN_USER=dev
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
ISSUER_ED25519_PRIV=

PASS_MAX_HOURS=24
RETENTION_PASS_DAYS=30
RETENTION_LOG_DAYS=90
TOKEN_TTL_HOURS=12
RATE_LIMIT_SCAN=30
RATE_LIMIT_PUBLIC=10
RATE_LIMIT_LOGIN=5

ML_URL=http://ml:8100
ML_SERVICE_TOKEN=CHANGE_ME_LONG_RANDOM_SERVICE_TOKEN
APP_BASE_URL=http://localhost:4000
APP_DOMAIN=localhost
APP_SCHEME=http
HTTP_HOST_PORT=4000

# --- Multi-origin static apps (GitHub Pages) --------------------------------
# Exact browser origins; never use "*". All role paths share one origin.
CORS_ALLOWED_ORIGINS=https://project-dawnguard.github.io
# Trust CF-Connecting-IP / X-Forwarded-For only from the proxy network.
# Set this to the actual Docker bridge subnet (docker network inspect ...).
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_CIDRS=172.16.0.0/12,127.0.0.1/32,::1/128
# Visitor links default to APP_BASE_URL. Set this when the Pages visitor app is live.
VISITOR_BASE_URL=
# Pages needs hash routes (#/fill/<token>, #/p/<token>); keep false until P1.
VISITOR_HASH_ROUTES=false
OFF_HOUR_START=22
OFF_HOUR_END=6
ANOMALY_CONTAMINATION=0.1
PHOTOS_DIR=/data/photos
AI_ARTIFACT_DIR=/data/artifacts
AI_MAX_QUERY_ROWS=50
PORT=8000
LOG_LEVEL=info

NEXT_PUBLIC_SAAS_URL=http://localhost:4000
API_URL=http://api:8000

# --- Deployment -------------------------------------------------------------
# Cloudflare Tunnel (home / college PC behind NAT). Leave empty to run locally.
# Public hostname -> service http://caddy:80 in the Zero Trust dashboard.
# When the tunnel is in use, also set:
#   APP_DOMAIN=visitors.example.com
#   APP_SCHEME=http
#   APP_BASE_URL=https://visitors.example.com
#   NEXT_PUBLIC_SAAS_URL=https://visitors.example.com
CLOUDFLARE_TUNNEL_TOKEN=

# Prebuilt images from GitHub Actions (docker-compose.prod.yml). Lowercase owner.
IMAGE_PREFIX=ghcr.io/CHANGE_ME_GITHUB_OWNER
IMAGE_TAG=latest
